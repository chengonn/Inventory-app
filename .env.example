# Copy to .env.local for development; set Production values in Vercel separately.
# Obtain both values from Supabase Dashboard > Connect / API Keys.
# URL must be the HTTPS project origin; key must start with sb_publishable_.
# Missing configuration returns HTTP 503 (never silently authenticated).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only allowed email; every business operation checks the authenticated user.
ALLOWED_USER_EMAIL=
# Step 3, server-only. Copy actual URIs from Supabase Connect; do not invent host/user.
# DATABASE_URL: shared Supavisor transaction mode, port 6543.
# pg TLS is configured in code (rejectUnauthorized=true); optional CA PEM below.
DATABASE_URL=
# DIRECT_URL: direct or shared session mode, port 5432.
# Prisma CLI requires query parameters sslmode=require&schema=inventory.
# It is never used as a fallback runtime connection.
DIRECT_URL=
# Maximum local pg connections PER warm serverless instance, not project-wide.
DB_POOL_MAX=2
# Optional server-only CA certificate PEM; literal \n sequences are accepted.
DATABASE_SSL_CA=
# Optional emergency read-only mode. Vercel Preview is always read-only.
INVENTORY_READ_ONLY=false
# Manual entry is the default. Enable only for an intentional legacy migration.
ENABLE_LEGACY_EXCEL_IMPORT=false
# Label a separately provisioned demo database; this does NOT isolate data itself.
INVENTORY_DEMO=false
# Optional visitor access, ONLY for the pinned separate demo project.
# Setup tool creates private .env.guest.local. Never expose these as NEXT_PUBLIC_*.
DEMO_GUEST_ENABLED=false
DEMO_GUEST_EMAIL=
DEMO_GUEST_USER_ID=
DEMO_GUEST_AUTH_PASSWORD=
DEMO_GUEST_PASSWORD_HASH=
DEMO_GUEST_COOKIE_KEY=
# Intentionally displayed on the demo login page. App share password ONLY, never backend password.
# Must match DEMO_GUEST_PASSWORD_HASH; leave empty to hide the public credential card.
DEMO_GUEST_PUBLIC_PASSWORD=
