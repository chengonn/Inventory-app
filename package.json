{
  "name": "internal-inventory-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/check-public-env.mjs --dev && prisma generate",
    "dev": "next dev",
    "prebuild": "node scripts/check-public-env.mjs && prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:moves": "node --use-system-ca scripts/test-moves-e2e.mjs",
    "test:e2e:stocktake": "node --use-system-ca scripts/test-moves-e2e.mjs",
    "test:e2e:query": "node --use-system-ca scripts/test-moves-e2e.mjs",
    "test:e2e:import": "node --use-system-ca scripts/test-moves-e2e.mjs",
    "test:e2e:review": "node --use-system-ca scripts/test-moves-e2e.mjs",
    "test:e2e:manual": "node --use-system-ca scripts/test-moves-e2e.mjs --manual-only",
    "test:production:anonymous": "node scripts/production-smoke.mjs",
    "postinstall": "prisma generate",
    "pretest": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "node scripts/require-migration-env.mjs && prisma migrate deploy",
    "db:migrate:status": "node scripts/require-migration-env.mjs && prisma migrate status",
    "db:smoke": "prisma generate && vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@next/env": "16.3.8",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/server": "^1.9.2",
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.115.0",
    "next": "16.3.8",
    "pg": "8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module",
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.3"
    }
  }
}
